#!/usr/bin/env bash
# Launcher instalado pelo .deb.
#
# O pacote NÃO contém o Granola. Na primeira execução ele pede o .dmg oficial
# (que o usuário baixa de granola.ai) e extrai para o diretório do usuário.
set -euo pipefail

PREFIX=/opt/granola-linux
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/granola-linux"
APP="$DATA/app-src"

die() { echo "granola-linux: $*" >&2; exit 1; }

# ── primeira execução: precisa do .dmg ───────────────────────────────────────
if [[ ! -d "$APP" ]]; then
    DMG="${1:-}"
    if [[ -z "$DMG" ]]; then
        # tenta achar sozinho nos lugares óbvios
        DMG=$(ls -t "$HOME"/Downloads/*ranola*.dmg "$HOME"/Downloads/*.dmg 2>/dev/null | head -1 || true)
    fi
    [[ -n "$DMG" && -f "$DMG" ]] || die "primeira execução precisa do .dmg oficial:
    granola-linux /caminho/para/'Granola - AI Notepad.dmg'
  (baixe em https://www.granola.ai/download, este pacote não o distribui)"

    command -v 7z >/dev/null || die "7z ausente (apt install p7zip-full)"
    echo "granola-linux: extraindo $(basename "$DMG") ..."
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    7z x -y -o"$tmp" "$DMG" 'Granola/Granola.app/Contents/Resources/*' >/dev/null
    asar="$tmp/Granola/Granola.app/Contents/Resources/app.asar"
    [[ -f "$asar" ]] || die "app.asar não encontrado, o .dmg é do Granola?"

    mkdir -p "$DATA"
    "$PREFIX/electron/resources/app/node_modules/.bin/asar" extract "$asar" "$APP" 2>/dev/null \
        || "$PREFIX/bin/asar-extract" "$asar" "$APP" \
        || die "falha ao desempacotar o app.asar"
    echo "granola-linux: app extraído em $APP"
fi

# ── execução ─────────────────────────────────────────────────────────────────
export GRANOLA_APP_DIR="$APP"
export GRANOLA_STUB_VERBOSE="${GRANOLA_STUB_VERBOSE:-0}"

exec "$PREFIX/electron/electron" "$PREFIX/stubs/loader.js" \
    --no-sandbox "${@:2}"
