#!/usr/bin/env bash
# Launcher installed by the .deb package.
#
# The package does NOT contain Granola. On first run it asks for the official
# .dmg (downloaded by the user from granola.ai) and extracts it under $HOME.
set -euo pipefail

PREFIX=/opt/granola-for-linux
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/granola-for-linux"
APP="$DATA/app-src"
SQLITE_PKG="node_modules/better-sqlite3-multiple-ciphers"
MARKER=".granola-for-linux"

die() { echo "granola-for-linux: $*" >&2; exit 1; }

# -- install or update from a .dmg --------------------------------------------
# Passing a .dmg always (re)extracts, which is how Granola is updated: download
# the new .dmg and run it through here again. Only consume the argument when it
# really is a .dmg, a granola:// callback or an Electron flag has to reach the
# app untouched.
DMG=""
if [[ "${1:-}" == *.dmg ]]; then
    DMG="$1"
    shift
elif [[ ! -d "$APP" ]]; then
    # nothing installed yet and no .dmg named: try the obvious location
    DMG=$(ls -t "$HOME"/Downloads/*ranola*.dmg "$HOME"/Downloads/*.dmg 2>/dev/null | head -1 || true)
    [[ -n "$DMG" && -f "$DMG" ]] || die "first run needs the official .dmg:
    granola-for-linux /path/to/'Granola - AI Notepad.dmg'
  (download it from https://www.granola.ai/download - this package does not ship it)"
fi

if [[ -n "$DMG" ]]; then
    [[ -f "$DMG" ]] || die "no such file: $DMG"
    command -v 7z >/dev/null || die "7z missing (apt install 7zip)"

    updating=false
    [[ -d "$APP" ]] && updating=true
    echo "granola-for-linux: extracting $(basename "$DMG") ..."
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    7z x -y -o"$tmp" "$DMG" 'Granola/Granola.app/Contents/Resources/*' >/dev/null
    asar="$tmp/Granola/Granola.app/Contents/Resources/app.asar"
    [[ -f "$asar" ]] || die "app.asar not found - is this really the Granola .dmg?"

    # Unpack beside the current install and swap, so a failure half way through
    # cannot leave a broken app behind.
    mkdir -p "$DATA"
    rm -rf "$APP.incoming"
    "$PREFIX/bin/asar-extract" "$asar" "$APP.incoming" || die "failed to unpack app.asar"
    rm -rf "$APP.previous"
    [[ -d "$APP" ]] && mv "$APP" "$APP.previous"
    mv "$APP.incoming" "$APP"
    rm -rf "$APP.previous"

    if $updating; then
        # The new tree carries Granola's own macOS sqlite again, and no marker,
        # so the swap below reinstalls the Linux build by itself.
        echo "granola-for-linux: updated from $(basename "$DMG")"
        version=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("version","?"))' \
            "$APP/package.json" 2>/dev/null || true)
        [[ -n "$version" ]] && echo "granola-for-linux: now running Granola $version"
    else
        echo "granola-for-linux: app extracted to $APP"
    fi
fi

# -- desktop icon --------------------------------------------------------------
# The .desktop entry names an icon the package cannot ship: it belongs to
# Granola. Take it from the user's own extraction instead, the same way the
# application itself is handled. The asset name carries a content hash that
# changes between Granola releases, hence the glob.
# 512x512 and not the asset's native 1024x1024: icon lookup only visits the
# size directories the hicolor theme declares, and its index stops at 512. An
# icon in an undeclared directory exists but is invisible to launchers, which
# then fall back to a blank entry. The larger image is simply scaled down.
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
ICON_DIR="$DATA_HOME/icons/hicolor/512x512/apps"
if [[ ! -f "$ICON_DIR/granola-for-linux.png" ]]; then
    icon=$(ls "$APP"/dist-app/assets/granola_app_icon-*.png 2>/dev/null | head -1 || true)
    if [[ -n "$icon" ]]; then
        mkdir -p "$ICON_DIR" "$DATA_HOME/pixmaps"
        cp "$icon" "$ICON_DIR/granola-for-linux.png"
        # legacy location too, for launchers that do not walk the hicolor theme
        cp "$icon" "$DATA_HOME/pixmaps/granola-for-linux.png"
        # drop the 1024x1024 copy earlier versions wrote into an unindexed dir
        rm -rf "$DATA_HOME/icons/hicolor/1024x1024"
        command -v gtk-update-icon-cache >/dev/null 2>&1 &&
            gtk-update-icon-cache -qtf "$DATA_HOME/icons/hicolor" 2>/dev/null || true
    fi
fi

# -- swap in the Linux SQLite module ------------------------------------------
# The bundle ships a Mach-O build, which fails here with "invalid ELF header";
# and even a stock Linux build would be missing the two features Granola's
# private fork provides (see scripts/build-sqlite.sh). Only the extracted copy
# is touched - the user's .dmg is never modified - and the marker makes this
# re-apply automatically after a Granola update is extracted afresh.
if [[ -d "$APP/$SQLITE_PKG" && ! -f "$APP/$SQLITE_PKG/$MARKER" ]]; then
    echo "granola-for-linux: installing the Linux sqlite module ..."
    rm -rf "$APP/$SQLITE_PKG"
    cp -r "$PREFIX/native/better-sqlite3-multiple-ciphers" "$APP/$SQLITE_PKG"
    touch "$APP/$SQLITE_PKG/$MARKER"
fi

# -- run ----------------------------------------------------------------------
export GRANOLA_APP_DIR="$APP"
export GRANOLA_STUBS_DIR="$PREFIX/stubs"
export GRANOLA_LINUX_NATIVE="$PREFIX/native/better-sqlite3-multiple-ciphers/build/Release"
export GRANOLA_STUB_VERBOSE="${GRANOLA_STUB_VERBOSE:-0}"

exec "$PREFIX/electron/electron" "$PREFIX/stubs/loader.js" --no-sandbox "$@"
